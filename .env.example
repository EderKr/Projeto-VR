# Porta usada pelo servidor. Plataformas como Render/Railway definem PORT automaticamente.
PORT=3000

# Host público. Use 0.0.0.0 em hospedagens.
HOST=0.0.0.0

# Caminho opcional para o banco JSON. Útil com disco persistente em produção.
# DB_PATH=/data/db.json

# Origem permitida para CORS. Use * somente em protótipo.
CORS_ORIGIN=*

# Banco de dados Supabase.
# Use true quando quiser salvar usuarios e historico no Supabase.
USE_SUPABASE=true
SUPABASE_URL=https://kieamfcqdoqajfujiyiv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImtpZWFtZmNxZG9xYWpmdWppeWl2Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3OTgyMDQzMSwiZXhwIjoyMDk1Mzk2NDMxfQ.ujhj0uf1gQ5hLb-rp7NcaIap-DCqarUDhzdGSpo36ng

# Banco local via Docker/PostgreSQL.
# Se USE_SUPABASE=true, o app usa Supabase e ignora o Postgres local.
USE_POSTGRES=false
DATABASE_URL=postgres://vruser:vrpassword@postgres:5432/vrgame
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vrgame
POSTGRES_USER=vruser
POSTGRES_PASSWORD=vrpassword
POSTGRES_SSL=false

# Quantidade máxima de partidas retornadas pela API.
HISTORY_LIMIT=100

# Autenticação simples do jogo. Troque por uma frase longa e secreta.
AUTH_SECRET=uma-frase-bem-grande-e-secreta
# Para Supabase no backend, use service role no servidor/Render. Não coloque essa chave no front-end.