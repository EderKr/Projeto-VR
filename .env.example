# ================================================================
# Headbutt Berserker — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores.
# No Coolify, configure essas variáveis pelo painel Environment Variables.
# ================================================================

# ----- Aplicação -----
# Porta interna do container (não altere sem ajustar o docker-compose)
APP_PORT=3000

# Origens permitidas para CORS. Em produção, use o domínio exato.
# Exemplo: https://meu-jogo.exemplo.com
CORS_ORIGIN=*

# Chave secreta para assinar tokens JWT. USE UMA FRASE LONGA E ALEATÓRIA.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=TROQUE-POR-UMA-FRASE-LONGA-E-SECRETA

# Máximo de partidas retornadas pela API de histórico
HISTORY_LIMIT=100

# ----- Banco de dados -----
POSTGRES_DB=vrgame
POSTGRES_USER=vruser
POSTGRES_PASSWORD=TROQUE-POR-UMA-SENHA-FORTE
